APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Require HTTPS for session cookies (true by default; set to false only for local HTTP development)
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Disk used for job attachment uploads. Set to "s3" in production.
ATTACHMENT_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SENDGRID_API_KEY=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

TRIAL_DAYS=14

# ------------------------------------------------------------------
# Titan Modules (config/titan-modules.php)
# ------------------------------------------------------------------
# TITAN_MODULES_PATH=Modules         # Relative path to the modules directory
# TITAN_MODULES_SAFE_BOOT=true       # Skip failing modules instead of crashing
# TITAN_MODULES_DISCOVERY=true       # Auto-discover modules from TITAN_MODULES_PATH
# TITAN_MODULES_AUTO_ENABLE=false    # Automatically enable newly discovered modules
# TITAN_MODULES_CACHE_MANIFESTS=true # Cache parsed module.json manifests

# ------------------------------------------------------------------
# Titan AI (config/titan-ai.php)
# ------------------------------------------------------------------
# TITAN_AI_PROVIDER=openai           # Default AI provider key (openai|anthropic|titanai)
# TITAN_AI_CHAT=true                 # Enable chat surface
# TITAN_AI_EMBEDDINGS=true           # Enable embeddings surface
# TITAN_AI_VISION=false              # Enable vision surface
# TITAN_AI_TTS=false                 # Enable text-to-speech surface
# TITAN_AI_AGENTS=true               # Enable AI agents
# TITAN_AI_AUDIT=true                # Log all AI calls and tool invocations
# TITAN_ZERO_GENERAL_KB=kb_general_cleaning  # General knowledge-base collection key

# ------------------------------------------------------------------
# Titan Model Runtime — OpenAI (config/titan-model-runtime.php)
# ------------------------------------------------------------------
OPENAI_API_KEY=
# TITAN_OPENAI_ENABLED=true
# OPENAI_BASE=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# Titan Model Runtime — Anthropic (config/titan-model-runtime.php)
# ------------------------------------------------------------------
# TITAN_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-haiku

# ------------------------------------------------------------------
# Titan Model Runtime — TitanAI SaaS (config/titan-model-runtime.php)
# ------------------------------------------------------------------
# TITAN_TITANAI_ENABLED=false
# TITAN_TITANAI_BASE_URL=https://your-titanai-domain.tld
# TITAN_TITANAI_API_KEY=
# TITAN_TITANAI_TIMEOUT=60

# ------------------------------------------------------------------
# Titan Model Runtime — Routing/Failover (config/titan-model-runtime.php)
# ------------------------------------------------------------------
# TITAN_ROUTING_EMBEDDINGS_PROVIDER=openai
# TITAN_ROUTING_EMBEDDINGS_MODEL=text-embedding-3-small
# TITAN_FAILOVER_ENABLED=false
# TITAN_FAILOVER_CHAIN=openai,anthropic

# ------------------------------------------------------------------
# Titan Model Runtime — Timeouts (config/titan-model-runtime.php)
# ------------------------------------------------------------------
# TITAN_TIMEOUT_CONNECT=10
# TITAN_TIMEOUT_REQUEST=60
# TITAN_TIMEOUT_STREAM=300

# ------------------------------------------------------------------
# Titan Model Runtime — Metrics (config/titan-model-runtime.php)
# ------------------------------------------------------------------
# TITAN_METRICS_ENABLED=true
# TITAN_METRICS_TOKEN=
# TITAN_METRICS_TTL=600

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_MAPS_API_KEY=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="${APP_ENV}"
VITE_SENTRY_DSN="${SENTRY_LARAVEL_DSN}"
VITE_APP_ENV="${APP_ENV}"

# Telescope — enable only in local/dev; keep disabled in production
TELESCOPE_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
