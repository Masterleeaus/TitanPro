CURATOR_DEFAULT_DISK=public
CURATOR_GLIDE_TOKEN=

# ------------------------------------------------------------------
# Titan Modules (config/titan-modules.php)
# ------------------------------------------------------------------
TITAN_MODULES_PATH=Modules
TITAN_MODULES_SAFE_BOOT=true
TITAN_MODULES_DISCOVERY=true
TITAN_MODULES_AUTO_ENABLE=false
TITAN_MODULES_CACHE_MANIFESTS=true
TITAN_MANIFEST_CACHE_PATH=
TITAN_STRICT_MANIFEST_VALIDATION=false
TITAN_SCHEMA_DOCS_PATH=docs/schemas

# ------------------------------------------------------------------
# Titan AI (config/titan-ai.php)
# ------------------------------------------------------------------
TITAN_AI_PROVIDER=openai
TITAN_AI_CHAT=true
TITAN_AI_EMBEDDINGS=true
TITAN_AI_VISION=false
TITAN_AI_TTS=false
TITAN_AI_AGENTS=true
TITAN_AI_AUDIT=true
TITAN_AI_ALLOWED_TOOLS=*
TITAN_AI_TOOL_TIMEOUT=30
TITAN_AI_TOOL_DRY_RUN=false
TITAN_ZERO_GENERAL_KB=kb_general_cleaning

# ------------------------------------------------------------------
# Titan Model Runtime — OpenAI (config/titan-model-runtime.php)
# ------------------------------------------------------------------
OPENAI_API_KEY=
TITAN_OPENAI_ENABLED=true
OPENAI_BASE=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=30

# ------------------------------------------------------------------
# Titan Model Runtime — Anthropic (config/titan-model-runtime.php)
# ------------------------------------------------------------------
TITAN_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_BASE=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-haiku

# ------------------------------------------------------------------
# Titan Model Runtime — TitanAI SaaS (config/titan-model-runtime.php)
# ------------------------------------------------------------------
TITAN_TITANAI_ENABLED=false
TITAN_TITANAI_BASE_URL=
TITAN_TITANAI_API_KEY=
TITAN_TITANAI_TIMEOUT=60

# ------------------------------------------------------------------
# Titan Model Runtime — Routing/Failover (config/titan-model-runtime.php)
# ------------------------------------------------------------------
TITAN_ROUTING_EMBEDDINGS_PROVIDER=openai
TITAN_ROUTING_EMBEDDINGS_MODEL=text-embedding-3-small
TITAN_FAILOVER_ENABLED=false
TITAN_FAILOVER_CHAIN=openai,anthropic

# ------------------------------------------------------------------
# Titan Model Runtime — Timeouts (config/titan-model-runtime.php)
# ------------------------------------------------------------------
TITAN_TIMEOUT_CONNECT=10
TITAN_TIMEOUT_REQUEST=60
TITAN_TIMEOUT_STREAM=300

# ------------------------------------------------------------------
# Titan Model Runtime — Metrics (config/titan-model-runtime.php)
# ------------------------------------------------------------------
TITAN_METRICS_ENABLED=true
TITAN_METRICS_TOKEN=
TITAN_METRICS_TTL=600

# AI Providers — Titan Core Model Runtime
# Primary provider: openai | local | failover
AI_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai

# Local model (Ollama, llama.cpp, LM Studio, etc.)
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_DEFAULT=llama3
LOCAL_MODEL_EMBED=nomic-embed-text
LOCAL_MODEL_TIMEOUT=60
AI_FAILOVER_ENABLED=false
AI_FAILOVER_CHAT_PROVIDERS=openai,local
AI_FAILOVER_EMBED_PROVIDERS=openai

# ------------------------------------------------------------------
# Titan Vector Store (config/titan-ai.php — vector_store section)
# ------------------------------------------------------------------
TITAN_VECTOR_STORE_DRIVER=pgvector
TITAN_PGVECTOR_DIMENSIONS=1536
TITAN_PGVECTOR_CONNECTION=pgsql
QDRANT_HOST=http://localhost:6333
QDRANT_COLLECTION=titan_vectors
QDRANT_API_KEY=
QDRANT_DIMENSIONS=1536
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=
MEILISEARCH_VECTOR_INDEX=titan_vectors
MEILISEARCH_VECTOR_DIMENSIONS=1536

VITE_APP_NAME="${APP_NAME}"
VITE_GOOGLE_MAPS_API_KEY="${GOOGLE_MAPS_API_KEY}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
