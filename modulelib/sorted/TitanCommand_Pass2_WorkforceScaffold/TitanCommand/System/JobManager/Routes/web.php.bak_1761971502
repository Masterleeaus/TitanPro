<?php

use Illuminate\Support\Facades\Route;
use Modules\JobManager\Http\Controllers\FsmSettingsController;

// Import controllers once, with unique aliases to avoid clashes with other modules
use Modules\JobManager\Http\Controllers\{
    DashboardController,
    ChecklistController,
    ClientPortalController as JobManagerClientPortalController,
    ClientSignController   as JobManagerClientSignController,
    QaPdfController,
    CommentsController,
    RecurrenceController,
    IcsExportController,
    WorkOrderStatusController
];

/**
 * Admin / staff (authenticated users)
 */
Route::middleware(['web','auth'])->group(function () {
    // FSM settings
    Route::get('/admin/fsm-settings',  [FsmSettingsController::class,'index'])->name('jobmanager.admin.fsm');
    Route::post('/admin/fsm-settings', [FsmSettingsController::class,'save'])->name('jobmanager.admin.fsm.save');

    // Internal dashboard + workorder actions
    Route::get('/fsm/dashboard', [DashboardController::class,'index'])->name('jobmanager.dashboard');

    Route::get('/jobmanager/{id}/checklists/picker', [ChecklistController::class,'picker'])->name('jobmanager.checklists.picker');
    Route::post('/jobmanager/{id}/checklists/attach', [ChecklistController::class,'attach'])->name('jobmanager.checklists.attach');
    Route::get('/jobmanager/{id}/checklists', [ChecklistController::class,'view'])->name('jobmanager.checklists.view');
    Route::post('/jobmanager/{id}/checklists/items/{itemId}', [ChecklistController::class,'updateItem'])->name('jobmanager.checklists.items.update');

    Route::get('/jobmanager/{id}/qa.pdf', [QaPdfController::class,'show'])->name('jobmanager.qa.pdf');

    Route::get('/jobmanager/{id}/comments',  [CommentsController::class,'index'])->name('jobmanager.widgets.comments');
    Route::post('/jobmanager/{id}/comments', [CommentsController::class,'store'])->name('jobmanager.comments.store');

    Route::post('/jobmanager/{id}/recurrence', [RecurrenceController::class,'store'])->name('jobmanager.recurrence.store');

    Route::get('/jobmanager/{id}/ics',       [IcsExportController::class,'workOrder'])->name('jobmanager.ics');
    Route::get('/contractors/schedule/ics',  [IcsExportController::class,'contractor'])->name('contractors.schedule.ics');

    Route::post('/jobmanager/{id}/complete', [WorkOrderStatusController::class,'complete'])->name('jobmanager.complete');
});

/**
 * Client portal (customer-facing). Use a distinct alias to avoid cross-module collisions.
 */
Route::middleware(['web','auth-client'])->prefix('account')->group(function () {
    Route::get('/jobmanager',            [JobManagerClientPortalController::class,'index'])->name('client.jobmanager.index');
    Route::get('/jobmanager/{id}',       [JobManagerClientPortalController::class,'show'])->name('client.jobmanager.show');
    Route::get('/jobmanager/{id}/sign',  [JobManagerClientSignController::class,'form'])->name('client.jobmanager.sign.form');
    Route::post('/jobmanager/{id}/sign', [JobManagerClientSignController::class,'submit'])->name('client.jobmanager.sign');
});

// Optional legacy aliases (only keep if you truly need them, otherwise remove to avoid duplicate route names)
Route::middleware(['web','auth-client'])->group(function () {
    Route::get('/client/jobmanager',                 [JobManagerClientPortalController::class,'index']);
    Route::get('/client/jobmanager/{id}',            [JobManagerClientPortalController::class,'show']);
    Route::get('/client/jobmanager/{id}/sign',       [JobManagerClientSignController::class,'form']);
    Route::post('/client/jobmanager/{id}/sign',      [JobManagerClientSignController::class,'submit']);
});

// ---- JobManager Dashboard Route ----
use Illuminate\Support\Facades\Route;
use Modules\JobManager\Http\Controllers\DashboardController;
use Modules\JobManager\Http\Controllers\Api\ComplianceHelperController;
use Modules\JobManager\Http\Controllers\ReportsController;
use Modules\JobManager\Http\Controllers\Api\SignoffController;

Route::middleware(['auth'])->group(function() {
    Route::get('/jobmanager/dashboard', [DashboardController::class, 'index'])->name('jobmanager.dashboard');
    Route::get('/jobmanager/upcoming/week', [DashboardController::class, 'upcomingWeek'])->name('jobmanager.upcoming.week');

    // Reports
    Route::prefix('jobmanager/reports')->group(function() {
        Route::get('/', [ReportsController::class, 'index'])->name('jobmanager.reports.index');
        Route::get('/revenue', [ReportsController::class, 'revenue'])->name('jobmanager.reports.revenue');
        Route::get('/compliance', [ReportsController::class, 'compliance'])->name('jobmanager.reports.compliance');
        Route::get('/timeline', [ReportsController::class, 'timeline'])->name('jobmanager.reports.timeline');
        Route::get('/audit', [ReportsController::class, 'audit'])->name('jobmanager.reports.audit');
    });

    // Compliance helper + Signoff
    Route::post('/jobmanager/compliance/generate-swms', [ComplianceHelperController::class, 'generateSWMS'])->name('jobmanager.compliance.generate');
    Route::post('/jobmanager/signoff/pdf', [SignoffController::class, 'pdf'])->name('jobmanager.signoff.pdf');
});

// ---- JobManager Client Portal ----
Route::middleware(['auth'])->prefix('client/jobmanager')->group(function() {
    Route::get('/index', function(){ return view('jobmanager::client.index'); })->name('client.jobmanager.index');
    Route::get('/sign/{id}', function($id){ return view('jobmanager::client.sign', compact('id')); })->name('client.jobmanager.sign');
});
