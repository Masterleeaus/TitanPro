{
  "module": "TitanChatbot",
  "manifest": "automation",
  "version": "2.0.0",
  "enabled": true,
  "triggers": [
    {
      "class": "Modules\\TitanEchoAssist\\Automation\\Triggers\\ConversationStartedTrigger",
      "listens_to": "Modules\\TitanEchoAssist\\Events\\ConversationStarted"
    },
    {
      "class": "Modules\\TitanEchoAssist\\Automation\\Triggers\\ConversationEscalatedTrigger",
      "listens_to": "Modules\\TitanEchoAssist\\Events\\ConversationEscalated"
    },
    {
      "class": "Modules\\TitanEchoAssist\\Automation\\Triggers\\IntentDetectedTrigger",
      "listens_to": "Modules\\TitanEchoAssist\\Events\\IntentDetected"
    },
    {
      "class": "Modules\\TitanEchoAssist\\Automation\\Triggers\\VoiceSessionStartedTrigger",
      "listens_to": "Modules\\TitanEchoAssist\\Events\\VoiceSessionStarted"
    }
  ],
  "handlers": [
    {
      "class": "Modules\\TitanEchoAssist\\Automation\\Handlers\\SendSuggestedPromptsHandler",
      "description": "Sends configured suggested prompts to the conversation channel"
    },
    {
      "class": "Modules\\TitanEchoAssist\\Automation\\Handlers\\SendWelcomeBannerHandler",
      "description": "Sends the welcome banner message to new conversations"
    },
    {
      "class": "Modules\\TitanEchoAssist\\Automation\\Handlers\\EscalateToAgentHandler",
      "description": "Escalates a conversation to a human agent and fires the escalation event"
    }
  ]
}