{
    "name": "TitanChatbot",
    "enabled": true,
    "priority": 10,
    "providers": [
        "Modules\\TitanChatbot\\Providers\\ModuleServiceProvider",
        "Modules\\TitanChatbot\\Providers\\AutomationServiceProvider",
        "Modules\\TitanChatbot\\Providers\\BillingServiceProvider",
        "Modules\\TitanChatbot\\Providers\\EventServiceProvider",
        "Modules\\TitanChatbot\\Providers\\FilamentServiceProvider",
        "Modules\\TitanChatbot\\Providers\\ModuleBootServiceProvider",
        "Modules\\TitanChatbot\\Providers\\PolicyServiceProvider",
        "Modules\\TitanChatbot\\Providers\\RepositoryServiceProvider",
        "Modules\\TitanChatbot\\Providers\\RouteServiceProvider",
        "Modules\\TitanChatbot\\Providers\\SearchServiceProvider",
        "Modules\\TitanChatbot\\Providers\\TenancyServiceProvider",
        "Modules\\TitanChatbot\\Providers\\TitanChatbotServiceProvider",
        "Modules\\TitanChatbot\\Providers\\WorkflowServiceProvider"
    ],
    "autoload": {
        "psr-4": {
            "Modules\\TitanChatbot\\": "./"
        }
    },
    "filament": {
        "panels": ["*"],
        "navigation": true,
        "resources_path": "Filament/Resources",
        "pages_path": "Filament/Pages",
        "widgets_path": "Filament/Widgets"
    },
    "health": {
        "checks": [
            "provider_exists",
            "filament_resources_valid",
            "translations_loaded",
            "routes_present",
            "migrations_present",
            "composer_psr4_present"
        ],
        "report_path": "Health/reports/latest.json"
    },
    "repair": {
        "recipes_path": "Repair/repair.php",
        "safe_auto_repair": true
    }
}
