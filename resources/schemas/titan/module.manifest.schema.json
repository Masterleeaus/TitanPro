{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://titan.local/schemas/module.manifest/v1.0.0",
  "title": "Titan Module Extended Manifest (module.manifest.json)",
  "description": "Extended manifest that supplements module.json with Filament, health, and repair configuration.",
  "type": "object",
  "required": ["name"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version this manifest conforms to.",
      "enum": ["1.0.0"]
    },
    "name": {
      "type": "string",
      "description": "Module name — must match the name in module.json.",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether the module is enabled."
    },
    "priority": {
      "type": "integer",
      "description": "Boot priority override.",
      "minimum": 0
    },
    "providers": {
      "type": "array",
      "description": "Additional or override providers.",
      "items": {
        "type": "string"
      }
    },
    "filament": {
      "type": "object",
      "description": "Filament panel integration settings.",
      "properties": {
        "panels": {
          "type": "array",
          "description": "Panel IDs this module injects into. Use [\"*\"] for all panels.",
          "items": {
            "type": "string"
          }
        },
        "navigation": {
          "type": "boolean",
          "description": "Whether navigation items are auto-registered."
        },
        "resources_path": {
          "type": "string"
        },
        "pages_path": {
          "type": "string"
        },
        "widgets_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "health": {
      "type": "object",
      "description": "Health check configuration.",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "report_path": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "repair": {
      "type": "object",
      "description": "Auto-repair configuration.",
      "properties": {
        "recipes_path": {
          "type": "string"
        },
        "safe_auto_repair": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
